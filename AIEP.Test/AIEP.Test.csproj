<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIEP.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NUnit2005 (NUnit.Analyzers 4.15, no sonaba en la 4.3 anterior): sugiere el modelo de
         constraint (Assert.That(...)) en vez del clasico (Assert.AreEqual). Se mantiene el
         clasico a proposito por consistencia con el Usings.cs institucional (ver README.md). -->
    <NoWarn>$(NoWarn);NUnit2005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />

    <!-- Pin directo: via ProjectReference a Api.Blueprint, Microsoft.Identity.Web trae
         System.Security.Cryptography.Pkcs/.Xml 10.0.10 con advisories conocidas. 10.0.13 las resuelve. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIEP.Application.Api.Blueprint\AIEP.Application.Api.Blueprint.csproj" />
    <ProjectReference Include="..\AIEP.Application.Logic\AIEP.Application.Logic.csproj" />
    <ProjectReference Include="..\AIEP.Application.Model\AIEP.Application.Model.csproj" />
    <ProjectReference Include="..\AIEP.Application.Repository\AIEP.Application.Repository.csproj" />
    <ProjectReference Include="..\AIEP.Domain.DataBlueprint\AIEP.Domain.DataBlueprint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
