<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AIEP.Application.Repository</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Acceso a datos sin ORM: un driver por motor soportado. Ambos 100% gestionados y multiplataforma. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <!-- Pin directo: Microsoft.Data.SqlClient 7.1.1 trae System.Security.Cryptography.Pkcs 9.0.18
         transitivamente, version con advisories NU1902/NU1903 conocidas. 10.0.13 las resuelve. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!-- Configuracion / opciones tipadas / logging / DI para el metodo de extension AddBlueprintRepository -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIEP.Domain.DataBlueprint\AIEP.Domain.DataBlueprint.csproj" />
    <ProjectReference Include="..\AIEP.Application.Model\AIEP.Application.Model.csproj" />
  </ItemGroup>

</Project>
