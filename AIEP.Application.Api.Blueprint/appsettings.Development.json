{
  // Desarrollo local. Sin Azure App Configuration -- Key Vault directo (Conf:KeyVaultUri, heredado
  // de appsettings.json) o appsettings*.json/user-secrets/variables de entorno.
  //
  // Auth:UseManagedIdentity=false => AzureCredentialFactory usa tu identidad local
  // (Visual Studio / az login) para leer Key Vault, no Managed Identity (eso es solo servidor).
  // Si tu cuenta no tiene acceso asignado en el Key Vault -- RBAC o access policy, segun el modo
  // del Vault, ver README "Identidad" (pasa con algunas instalaciones de
  // Visual Studio + Azure Arc), no hace falta esperar a que te lo asignen -- Program.cs atrapa ese
  // fallo y sigue arrancando. Respaldo OFICIAL para desarrollo: dotnet user-secrets (nunca se sube
  // al repo). Desde AIEP.Application.Api.Blueprint:
  //   dotnet user-secrets init
  //   dotnet user-secrets set "ConnectionStrings:SqlServerDb" "cadena-local"
  //   dotnet user-secrets set "Conf:ApiKey" "valor-local"
  // (Vault sigue teniendo prioridad si llega a resolver algo; esto es solo respaldo. Alternativa,
  // menos recomendable porque queda versionada: escribir la cadena real directo en
  // Database:Connections:<Nombre>:ConnectionString en appsettings.json.)
  //
  // Ambas conexiones (Database:Connections:OracleDb / :SqlServerDb) ya se declaran en
  // appsettings.json; aqui solo se elige cual usa el feature Recurso en local, para poder
  // probarlo contra SQL Server sin tocar Oracle:
  //   "Conf": { "RecursoConnectionName": "OracleDb" }
  //
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "UseManagedIdentity": false
  },
  "Conf": {
    "RecursoConnectionName": "SqlServerDb"
  }
}
