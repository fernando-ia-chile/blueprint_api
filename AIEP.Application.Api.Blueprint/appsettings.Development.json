{
  // Desarrollo local. Sin App Configuration (Endpoint vacio) => la config sale de
  // appsettings*.json + user-secrets + variables de entorno.
  //
  //   dotnet user-secrets set "ConnectionStrings:BlueprintDb" "<cadena real>"
  //   dotnet user-secrets set "Conf:ApiKey" "<api key de pruebas>"
  //
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureAppConfig": {
    "Endpoint": ""
  },
  "Database": {
    "Provider": "SqlServer"
  }
}
