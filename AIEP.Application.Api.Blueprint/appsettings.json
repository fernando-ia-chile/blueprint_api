  // ─────────────────────────────────────────────────────────────────────────────
  // Sin Azure App Configuration: en entornos desplegados, ConnectionStrings:<Nombre> y
  // Conf:ApiKey llegan DIRECTO desde Key Vault (Program.cs -> AddAzureKeyVault +
  // BlueprintKeyVaultSecretManager), un secreto por cadena de conexion, nombrados
  // "blueprint-<nombre>-connectionstring" / "blueprint-api-key". Credencial explicita: ver
  // AzureCredentialFactory / "Auth" abajo (Managed Identity en Azure o en un servidor con agente de Azure Arc).
  // Si una conexion no puede llegar al Vault (ej. un desarrollador sin rol asignado ahi), puede
  // escribirse el valor directo en Database:Connections:<Nombre>:ConnectionString -- Vault sigue
  // teniendo prioridad si resuelve algo; el valor directo es solo respaldo. Ver esa seccion abajo.
  // ─────────────────────────────────────────────────────────────────────────────
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "aiep.cl",
    "TenantId": "dc09f18d-6ac3-4ef0-a01e-66525ed9a4d0", // tenant Colaboradores
    "ClientId": "d5c5fbbd-aaa2-4456-b95a-2ac9733ce0ef"
  },
  // Credencial para leer Key Vault directo (AzureCredentialFactory). Separado de "AzureAd" (que
  // es solo para validar el JWT entrante): esta API nunca adquiere tokens propios, asi que
  // "AzureAd" jamas lleva ClientSecret.
  "Auth": {
    "UseManagedIdentity": true,
    "ManagedIdentityClientId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "https://servicioalumno.aiep.cl" ]
  },
  // Mas de una conexion simultanea: una entrada por conexion, cada una con su propio
  // ConnectionStringName -> ConnectionStrings:<Nombre> (secreto de Key Vault directo:
  // blueprint-oracledb-connectionstring / blueprint-sqlserverdb-connectionstring). Vault tiene
  // prioridad; si no resuelve nada, se usa el "ConnectionString" literal de esa misma entrada (si
  // lo hay). Si ninguna de las dos fuentes tiene valor, esa conexion se omite sola -- no rompe el
  // arranque. Para dejar de usar una conexion: borrar su nodo, o dejar ambos campos vacios.
  "Database": {
    "Connections": {
      "OracleDb": { "Provider": "Oracle", "ConnectionStringName": "OracleDb", "CommandTimeout": 300 },
      "SqlServerDb": { "Provider": "SqlServer", "ConnectionStringName": "SqlServerDb", "CommandTimeout": 300 }
    }
  },
  "Conf": {
    "KeyVaultUri": "https://keyvault-aiep-desa.vault.azure.net",
    "ApiKeyHeaderName": "x-xmsbs-apikey",
    "StoredProcedureName": "PKG_BLUEPRINT.P_GET_RECURSO",
    "RecursoConnectionName": "OracleDb",
