{
  // ─────────────────────────────────────────────────────────────────────────────
  // SIN SECRETOS. En entornos desplegados, ConnectionStrings:BlueprintDb y Conf:ApiKey
  // los entrega Azure App Configuration como referencias a Key Vault (DefaultAzureCredential).
  // En local: usar 'dotnet user-secrets' o variables de entorno.
  // ─────────────────────────────────────────────────────────────────────────────
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "aiep.cl",
    "TenantId": "<tenant-id>",
    "ClientId": "<client-id>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "https://servicioalumno.aiep.cl" ]
  },
  "AzureAppConfig": {
    "Endpoint": "https://appcs-aiep-desa.azconfig.io"
  },
  "Database": {
    "Provider": "Oracle",
    "CommandTimeout": 300,
    "ConnectionStringName": "BlueprintDb"
  },
  "Conf": {
    "KeyVaultUri": "https://keyvault-aiep-desa.vault.azure.net",
    "ApiKeyHeaderName": "x-xmsbs-apikey",
    "StoredProcedureName": "PKG_BLUEPRINT.P_GET_RECURSO",
    "ListTenantId": [ "<tenant-id>" ]
  }
}
